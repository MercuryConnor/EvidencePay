# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# LLM Configuration
LLM_PROVIDER=google   # openai | google
LLM_MODEL_POOL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash        # model name
LLM_TEMPERATURE=0.0          # deterministic extraction
LLM_MAX_RETRIES=3            # max retries per LLM call

# Pipeline Configuration
MAX_EXTRACTION_PASSES=3      # max passes per document
LOG_LEVEL=INFO
